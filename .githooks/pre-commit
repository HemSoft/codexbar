#!/bin/sh
# CodexBar pre-commit hook
# Runs the Rust app's quality gates before allowing a commit. The retired C# / WPF app's gates (format, build,
# tests) run only when the commit touches its files, so its desktop UI Automation tests don't gate Rust work.

set -e

echo "🔍 Running pre-commit checks..."

echo "  → Checking Rust formatting..."
cargo fmt --all --check

echo "  → Running Clippy..."
cargo clippy --workspace --all-targets --locked --quiet -- -D warnings

echo "  → Running Rust tests..."
cargo test --workspace --locked --quiet

if git diff --cached --name-only | grep -Eq '^src/|\.(cs|csproj|sln|props|targets|xaml)$'; then
    echo "  → C# files changed: checking formatting..."
    dotnet format --verify-no-changes

    echo "  → Building..."
    dotnet build --no-restore

    echo "  → Running tests..."
    dotnet test --no-build
fi

echo "✅ All pre-commit checks passed!"
